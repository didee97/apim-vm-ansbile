# {{ ansible_managed }}
{% for site in [
     {'name': cp_domain, 'upstream': 'apim_cp', 'log': 'cp'},
     {'name': gw_domain, 'upstream': 'apim_gw', 'log': 'gw'},
   ] %}
# ---------- {{ site.name }} ----------
server {
    listen 80;
    server_name {{ site.name }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name {{ site.name }};

    ssl_certificate     {{ ssl_dir }}/apim.crt;
    ssl_certificate_key {{ ssl_dir }}/apim.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 100m;

    location / {
        proxy_pass https://{{ site.upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 5m;
        proxy_send_timeout 5m;
    }

    access_log /var/log/nginx/{{ site.log }}_https_access.log;
    error_log  /var/log/nginx/{{ site.log }}_https_error.log;
}

{% endfor %}
