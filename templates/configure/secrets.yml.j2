---
# Generated by configure.yml. Keep out of git.
# Encrypt with: ansible-vault encrypt group_vars/all/20-secrets.yml
db_password: {{ secrets.db_password | to_json }}
apim_admin_password: {{ secrets.apim_admin_password | to_json }}
{% if cfg.db_type == 'mssql' %}
mssql_sa_password: {{ secrets.mssql_sa_password | to_json }}
{% endif %}
{% if cfg.fluent_bit_install %}
opensearch_password: {{ secrets.opensearch_password | to_json }}
{% endif %}
