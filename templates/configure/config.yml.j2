---
# Generated by ./configure.sh - re-run it instead of editing by hand
db_type: {{ cfg.db_type }}

# WSO2 APIM package: opensource (downloaded from GitHub) or licensed (zip on this PC)
apim_distribution: {{ cfg.apim_distribution | default('opensource') }}
{% if cfg.apim_distribution | default('opensource') == 'licensed' %}
apim_zip_src: {{ cfg.apim_zip_src }}
{% endif %}

cp_domain: {{ cfg.cp_domain }}
gw_domain: {{ cfg.gw_domain }}
gateway_ip: {{ cfg.gateway_ip }}

ssl_mode: {{ cfg.ssl_mode }}
{% if cfg.ssl_mode == 'existing' %}
ssl_cert_src: {{ cfg.ssl_cert_src }}
ssl_key_src: {{ cfg.ssl_key_src }}
{% endif %}

sudo_ask: "{{ cfg.sudo_ask }}"
{% if cfg.db_type == 'mssql' %}

mssql_pid: "{{ cfg_mssql_pid }}"
mssql_accept_eula: {{ cfg_mssql_eula }}
{% endif %}

# Environment tag on analytics events (env=<name> in OpenSearch)
apim_env: {{ cfg.apim_env }}

# Fluent Bit -> OpenSearch (API analytics)
fluent_bit_install: {{ cfg.fluent_bit_install }}
{% if cfg.fluent_bit_install %}
opensearch_host: {{ cfg.opensearch_host }}
opensearch_port: {{ cfg.opensearch_port }}
opensearch_user: {{ cfg.opensearch_user }}
opensearch_tls_verify: {{ cfg.opensearch_tls_verify }}
{% endif %}
