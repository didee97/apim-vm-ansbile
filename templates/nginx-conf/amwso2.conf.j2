# Redirect HTTP to HTTPS for API
server {
    listen 80;
    server_name am-uat.{{ domain_name }};
    return 301 https://$host$request_uri;
}

# HTTPS Server Block for API
server {
    listen 443 ssl;
    server_name am-uat.{{ domain_name }};

    ssl_certificate {{ ssl_dir }}/apim.crt;
    ssl_certificate_key {{ ssl_dir }}/apim.key;

    location / {
        proxy_pass https://sslam-uat;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 5m;
        proxy_send_timeout 5m;
    }

    access_log /var/log/nginx/api_https_access.log;
    error_log /var/log/nginx/api_https_error.log;
}

# Redirect HTTP to HTTPS for Gateway
server {
    listen 80;
    server_name api-uat.{{ domain_name }};
    return 301 https://$host$request_uri;
}

# HTTPS Server Block for Gateway
server {
    listen 443 ssl;
    server_name api-uat.{{ domain_name }};

    ssl_certificate {{ ssl_dir }}/apim.crt;
    ssl_certificate_key {{ ssl_dir }}/apim.key;

    location / {
        proxy_pass https://sslapi-uat;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 5m;
        proxy_send_timeout 5m;
    }

    access_log /var/log/nginx/gw_https_access.log;
    error_log /var/log/nginx/gw_https_error.log;
}

